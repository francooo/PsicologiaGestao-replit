# Banco de dados (obrigatório)
# Use o endpoint "pooled" do Neon (host com "-pooler") em produção no Vercel.
DATABASE_URL=

# Sessão (obrigatório em produção — o código tem um fallback inseguro só para dev local)
SESSION_SECRET=

# IA / análise de notas fiscais (obrigatório para os recursos de IA)
GROQ_API_KEY=
# Opcional: modelos da Groq (troque aqui se a Groq desativar algum; padrões no código)
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Assistente (chat): o modelo é o GROQ_TEXT_MODEL; o áudio é transcrito por este
# GROQ_STT_MODEL=whisper-large-v3-turbo
# Mensagens por usuário por hora no assistente (padrão 40)
# AGENT_HOURLY_LIMIT=40

# Envio de e-mail / recuperação de senha (obrigatório para esse fluxo)
RESEND_API_KEY=
# Remetente dos e-mails (formulários de cuidado, recuperação de senha). Precisa ser de um domínio
# verificado em resend.com/domains; sem isso o Resend só entrega para o dono da conta.
# EMAIL_FROM=ConsultaPsi <nao-responda@seudominio.com.br>
# Sem domínio próprio: conta Gmail do sistema + senha de app (myaccount.google.com → Segurança →
# Senhas de app). Com as duas preenchidas, todos os e-mails saem por ela em vez do Resend.
# SMTP_USER=consultapsi.avisos@gmail.com
# SMTP_PASS=
# Cópia oculta (Bcc) de todo e-mail de convite de administrador (padrão andrewsfranco93@gmail.com; vazio desliga)
# ADMIN_INVITE_BCC=

# URL pública da aplicação em produção (obrigatório fora do Replit/local)
# Ex.: https://seu-projeto.vercel.app
APP_URL=
BASE_URL=

# Login com Google / Google Calendar (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# WhatsApp (opcional)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=

# Cosmético (opcional, default "ConsultaPsi")
CLINIC_NAME=

# Não definir em produção no Vercel:
# PORT (só usado pelo .listen() local)
# REPL_ID (deve ficar ausente fora do Replit)

# Multi-empresa: super admins da plataforma (criam empresas e entram em qualquer uma como admin)
# E-mails separados por vírgula. Ex.: PLATFORM_ADMIN_EMAILS=dono@exemplo.com,suporte@exemplo.com
PLATFORM_ADMIN_EMAILS=

# Painel do dono (app separado): origens liberadas no CORS de /api/platform/*, login, /api/user e logout,
# e destinos aceitos no retorno do login com Google (?token=). Separadas por vírgula, sem barra no final.
# Ex.: PAINEL_ORIGIN=https://painel.consultapsi.com.br,http://localhost:5174
PAINEL_ORIGIN=

# WhatsApp automático (Twilio) — um remetente da plataforma para todas as clínicas
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox: whatsapp:+14155238886 · produção: whatsapp:+55DDNUMERO
TWILIO_WHATSAPP_FROM=
# SID (HX...) do modelo lembrete_consulta aprovado; vazio = texto livre (só Sandbox)
TWILIO_REMINDER_CONTENT_SID=
# Segredo do agendador (cron-job.org e Vercel Cron): Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
